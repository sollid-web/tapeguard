# Copy to foundry/.env locally; never commit it. Used by script/LaunchTapeGuard.s.sol.
PRIVATE_KEY=0x
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional (needed for trading): UniswapV2-style router and USDT on X Layer
# ROUTER=0x...
# USDT=0x...
# Optional: reuse an already taped-out guard circuit instead of creating one
# TAPEOUT_CIRCUITS=0x...
# TAPEOUT_CIRCUIT_ID=1
X_LAYER_RPC_URL=https://rpc.xlayer.tech
